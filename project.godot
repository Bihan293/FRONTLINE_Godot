config_version=5

[application]
config/name="FRONTLINE"
config/description="Low-poly mobile military FPS prototype"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/auto_accept_quit=true
config/icon="res://icon.svg"

[autoload]

GameSettings="*res://scripts/game_settings.gd"
BotNavigation="*res://scripts/bot_navigation.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.15, 1)

[physics]
3d/default_gravity=18.0
